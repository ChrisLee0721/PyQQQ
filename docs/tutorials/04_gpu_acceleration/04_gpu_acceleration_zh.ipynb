{
 "cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# 教程 04：GPU 加速\n", "\n", "使用 GPU 加速量子电路模拟。"]},{"cell_type": "markdown", "metadata": {}, "source": ["## 标准执行"]},{"cell_type": "code", "metadata": {}, "source": ["from quonic import qgate, qshow, reset
", "from quonic.gates import CX, H
", "
", "# 标准执行（自动选择最佳后端）
", "reset()
", "qgate(H, 0)
", "qgate(CX, 0, 1)
", "result = qshow()
", "print(f'后端: native, 结果: {result.counts}')"], "outputs": [], "execution_count": null},{"cell_type": "markdown", "metadata": {}, "source": ["## 智能调度"]},{"cell_type": "code", "metadata": {}, "source": ["from quonic.scheduler import circuit_features, recommend_backend_gpu
", "from quonic.stack import current_circuit
", "
", "reset()
", "qgate(H, 0)
", "qgate(CX, 0, 1)
", "
", "feats = circuit_features(current_circuit())
", "rec = recommend_backend_gpu(feats)
", "print(f'电路特征: n={feats["n"]}, 纠缠={feats["entanglement"]}')
", "print(f'最佳 GPU 后端: {rec.backend} ({rec.method})')"], "outputs": [], "execution_count": null},{"cell_type": "markdown", "metadata": {}, "source": ["## CuPy GPU 引擎"]},{"cell_type": "code", "metadata": {}, "source": ["# CuPy GPU 引擎（需要安装 CuPy）
", "# pip install cupy-cuda12x
", "try:
", "    result = qshow(backend='cupy')
", "    print(f'CuPy GPU 结果: {result.counts}')
", "except ImportError:
", "    print('CuPy 未安装 — 安装: pip install cupy-cuda12x')"], "outputs": [], "execution_count": null}],
